{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "metadata_edit_flutter_python_rpc.schema.json",
  "title": "metadata_edit Flutter Python RPC",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string"
    },
    "module": {
      "const": "metadata_edit"
    },
    "action": {
      "type": "string",
      "enum": [
        "load_targets",
        "lock_config",
        "start_cover_injection_task",
        "start_filename_injection_task",
        "stop_task",
        "subscribe_task_events",
        "fetch_metadata_edit_result",
        "load_templates",
        "save_template",
        "delete_template"
      ]
    },
    "payload": {
      "type": "object"
    },
    "ok": {
      "type": "boolean"
    },
    "data": {
      "type": ["object", "null"]
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["code", "message"],
      "additionalProperties": false
    },
    "event": {
      "type": "string",
      "enum": [
        "task_created",
        "task_progress",
        "task_status_changed",
        "task_finished",
        "task_error"
      ]
    },
    "task_id": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
