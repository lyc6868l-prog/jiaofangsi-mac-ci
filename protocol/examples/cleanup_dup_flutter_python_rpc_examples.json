    "start_duplicate_check_task": {
      "request_id": "req_003",
      "module": "cleanup_dup",
      "action": "start_duplicate_check_task",
      "payload": {
        "panel": "duplicate_search"
      }
    },
    "execute_delete": {
      "request_id": "req_004",
      "module": "cleanup_dup",
      "action": "execute_delete",
      "payload": {
        "task_id": "task_dup_001",
        "move_to_recycle_bin": true,
        "selected_files": [
          {
            "path": "/music/Fade_copy.mp3",
            "name": "Fade_copy.mp3",
            "size": "8.2 MB"
          }
        ]
      }
    }
  },
  "responses": {
    "success": {
      "request_id": "req_003",
