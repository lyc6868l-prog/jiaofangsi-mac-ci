{
  "unlock_music": {
    "requests": {
      "load_targets": {
        "request_id": "req_001",
        "module": "unlock_music",
        "action": "load_targets",
        "payload": {
          "panel": "unlock",
          "file_paths": [
            "/music/Fade.qmc0",
            "/music/Broken.ncm"
          ]
        }
      },
      "lock_config": {
        "request_id": "req_002",
        "module": "unlock_music",
        "action": "lock_config",
        "payload": {
          "panel": "unlock",
          "config": {
            "output_dir": "/output",
            "overwrite": false,
            "keep_source": true
          }
        }
      },
      "start_unlock_task": {
        "request_id": "req_003",
        "module": "unlock_music",
        "action": "start_unlock_task",
        "payload": {
          "panel": "unlock"
        }
      },
      "fetch_unlock_result": {
        "request_id": "req_004",
        "module": "unlock_music",
        "action": "fetch_unlock_result",
        "payload": {
          "task_id": "task_unlock_001"
        }
      }
    },
    "responses": {
      "success": {
        "request_id": "req_003",
        "ok": true,
        "data": {
          "task_id": "task_unlock_001",
          "panel": "unlock",
          "task_type": "unlock",
          "status": "running",
          "progress": 0.01,
          "progress_hint_text": "正在准备解锁任务...",
          "file_count": 2,
          "success_count": 0,
          "failed_count": 0
        },
        "error": null
      },
      "error": {
        "request_id": "req_004",
        "ok": false,
        "data": null,
        "error": {
          "code": "TASK_NOT_COMPLETED",
          "message": "当前任务仍在运行中。"
        }
      }
    },
    "events": {
      "task_progress": {
        "module": "unlock_music",
        "event": "task_progress",
        "task_id": "task_unlock_001",
        "data": {
          "panel": "unlock",
          "task_type": "unlock",
          "status": "running",
          "progress": 0.5,
          "progress_hint_text": "正在解锁... 1/2",
          "file_count": 2,
          "success_count": 1,
          "failed_count": 0
        }
      },
      "task_finished": {
        "module": "unlock_music",
        "event": "task_finished",
        "task_id": "task_unlock_001",
        "data": {
          "panel": "unlock",
          "task_type": "unlock",
          "status": "success",
          "progress": 1.0,
          "progress_hint_text": "解锁任务执行完毕。",
          "file_count": 2,
          "success_count": 1,
          "failed_count": 1
        }
      }
    }
  },
  "search_download": {
    "requests": {
      "lock_config": {
        "request_id": "req_101",
        "module": "search_download",
        "action": "lock_config",
        "payload": {
          "panel": "search",
          "config": {
            "output_dir": "/output",
            "sources": [
              "QQ音乐",
              "酷我音乐"
            ],
            "playlist_url": "https://music.example/playlist/123"
          }
        }
      },
      "start_playlist_parse_task": {
        "request_id": "req_102",
        "module": "search_download",
        "action": "start_playlist_parse_task",
