      },
      "task_finished": {
        "module": "search_download",
        "event": "task_finished",
        "task_id": "task_download_001",
        "data": {
          "panel": "search",
          "task_type": "download",
          "status": "success",
          "progress": 1.0,
          "progress_hint_text": "下载任务执行完毕。",
          "total_count": 1,
          "success_count": 1,
          "failed_count": 0,
          "log_lines": [
            "[System] 下载完成: Fade"
