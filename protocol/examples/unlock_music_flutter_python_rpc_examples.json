          "panel": "search"
        }
      },
      "start_download_task": {
        "request_id": "req_103",
        "module": "search_download",
        "action": "start_download_task",
        "payload": {
          "panel": "search",
          "song_infos": [
            {
              "source": "QQMusicClient",
              "song_name": "Fade",
              "identifier": "song_001",
              "with_valid_download_url": true
            }
          ]
        }
      },
      "fetch_download_result": {
        "request_id": "req_104",
        "module": "search_download",
        "action": "fetch_download_result",
        "payload": {
          "task_id": "task_download_001"
        }
      }
    },
    "responses": {
      "success": {
        "request_id": "req_102",
        "ok": true,
        "data": {
          "task_id": "task_playlist_parse_001",
          "panel": "search",
          "task_type": "playlist_parse",
          "status": "running",
          "progress": 0.01,
          "progress_hint_text": "正在准备任务...",
          "total_count": 0,
          "success_count": 0,
          "failed_count": 0,
          "log_lines": []
        },
        "error": null
      },
      "error": {
        "request_id": "req_104",
        "ok": false,
        "data": null,
        "error": {
          "code": "TASK_NOT_COMPLETED",
          "message": "当前任务仍在运行中。"
        }
      }
    },
    "events": {
      "task_progress": {
        "module": "search_download",
        "event": "task_progress",
        "task_id": "task_download_001",
        "data": {
          "panel": "search",
          "task_type": "download",
          "status": "running",
          "progress": 0.4,
          "progress_hint_text": "正在下载: Fade",
          "total_count": 1,
          "success_count": 0,
          "failed_count": 0,
          "log_lines": [
